# Eregion configuration example. Copy to .env ONLY if .env does not exist yet;
# otherwise add the missing lines by hand and keep your existing values.
# Process environment variables override this file. Restart the service after edits.

# --- Model connection (required) ---
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=
# Optional structured reader; defaults to the main model.
LLM_EXTRACTION_MODEL_ID=
# Uses extraction reasoning if configured, otherwise low. Set only to a provider-supported level.
LLM_REASONING_SEARCH_QUALIFICATION=

# --- Optional: Treg (your own account, your own cost). Disabled by default. ---
# Filling in TREG_TOKEN does not enable any paid call. Turn on JOB_AGENT_TREG_ENABLED yourself.
TREG_TOKEN=
# Only for an identity token (org-scoped tokens do not need it).
TREG_ORG=
JOB_AGENT_TREG_ENABLED=0
# API-first job search using existing company boards (no Treg needed, no cost).
JOB_AGENT_JOB_API_FIRST=1
# anyapi or crawl4ai; leave empty until you have chosen (see docs/configuration.md).
JOB_AGENT_TREG_SEARCH_PROVIDER=
JOB_AGENT_TREG_CRAWL4AI_SCRAPE_ENABLED=0
JOB_AGENT_TREG_TASK_MAX_COST_USD=0.10
JOB_AGENT_TREG_DAILY_MAX_COST_USD=0.50
JOB_AGENT_TREG_CALL_MAX_COST_USD=0.01
JOB_AGENT_TREG_MAX_ATTEMPTS=20
JOB_AGENT_TREG_MAX_RESULTS=10
JOB_AGENT_TREG_MAX_PAGES=2
JOB_AGENT_TREG_MAX_CONCURRENCY=2
# Explicit opt-in for the isolated live API smoke test only. Normal tests never spend.
JOB_AGENT_TREG_LIVE_API_TEST=0

# --- Optional: JobSpy job search (no key; off unless configured) ---
# Path to a separate Python that has python-jobspy installed (it needs pandas/curl_cffi,
# which the server environment does not include). Leave empty to keep JobSpy off.
JOB_AGENT_JOBSPY_PYTHON=
# Comma-separated: indeed, linkedin. Requests per task are capped.
JOB_AGENT_JOBSPY_SITES=indeed
JOB_AGENT_JOBSPY_RESULTS=20
JOB_AGENT_JOBSPY_TIMEOUT=60
JOB_AGENT_JOBSPY_MAX_REQUESTS=80

# --- Application browser driver ---
# playwright (default) or patchright. Switching back is the rollback.
JOB_AGENT_BROWSER_DRIVER=playwright
# Optional IANA time zone for dates the agent shows (e.g. America/New_York); else the machine zone, marked unconfirmed.
JOB_AGENT_USER_TIMEZONE=

# --- Integrated request/material options ---
JOB_AGENT_OPT_BOARD_RESPONSE_CACHE=0
# API-first defaults these two to enabled when unset; 0 is an explicit rollback.
JOB_AGENT_OPT_CANDIDATE_BATCHES=1
JOB_AGENT_OPT_SCOPED_CONTEXT=0
JOB_AGENT_OPT_STATE_DELTAS=0
JOB_AGENT_OPT_MATERIAL_PATCHES=0
JOB_AGENT_OPT_SNAPSHOT_REFS=0
JOB_AGENT_OPT_STABLE_TOOLS=0
JOB_AGENT_OPT_PROMPT_TRIM=0
JOB_AGENT_OPT_VERIFY_AND_SCORE=1
# current | aligned | checkpoint | structured_checkpoint
JOB_AGENT_OPT_HISTORY_POLICY=current

# LinkedIn MCP is configured through an absolute MCP_CONFIG_PATH in the backend process environment or project .env.
# See docs/configuration.md: Default job sources. No LinkedIn/Treg API key needed for MCP.
MCP_CONFIG_PATH=
